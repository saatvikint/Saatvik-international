# Public URL of the site, used for metadata, canonical URLs and Open Graph (config/APP_CONFIG.ts).
# The business-card domain (saatvikinternational.com) is not registered yet; see .agent/client/open-questions.md Q1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheet that collects every enquiry (client sheet 1OAulzZC…). Web app URL of scripts/google-sheet-enquiries.gs
# (ends in /exec) and the same secret as SECRET in that script. Setup: .agent/developer/enquiry-flow.md.
ENQUIRY_SHEET_WEBHOOK_URL=
ENQUIRY_SHEET_SECRET=mbh4t7sdkhw4u3iuriirh4574983

# Optional: path of the SQLite enquiry store (local backup copy) (lib/enquiry-store.ts). Defaults to data/enquiries.sqlite.
ENQUIRY_DB_PATH=
# Optional: public origin accepted by the enquiry API when behind a proxy (app/api/enquiries/route.ts).
ENQUIRY_PUBLIC_ORIGIN=

# Show draft company media slots in a production build, for design-review previews only.
# Never set this on the live site.
NEXT_PUBLIC_SHOW_DRAFT_CONTENT=false
