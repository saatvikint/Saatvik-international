# Public URL of the site, used for metadata, canonical URLs and Open Graph (config/APP_CONFIG.ts).
# The business-card domain (saatvikinternational.com) is not registered yet; see .agent/client/open-questions.md Q1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: path of the SQLite enquiry store (lib/enquiry-store.ts). Defaults to data/enquiries.sqlite.
ENQUIRY_DB_PATH=
# Optional: public origin accepted by the enquiry API when behind a proxy (app/api/enquiries/route.ts).
ENQUIRY_PUBLIC_ORIGIN=

# Show draft/sample content (e.g. sample testimonials) in a production build, for design-review previews only.
# Never set this on the live site.
NEXT_PUBLIC_SHOW_DRAFT_CONTENT=false
